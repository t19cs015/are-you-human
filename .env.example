OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Vercel: connect Upstash Redis through the Marketplace. Keep these server-only.
# The integration's KV_REST_API_URL / KV_REST_API_TOKEN names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional daily limits shared by all players in each deployment environment.
# A value of 0 disables that live feature. Authored gameplay remains available.
AI_TOWN_DAILY_TEXT_LIMIT=1000
AI_TOWN_DAILY_SPEECH_LIMIT=500
AI_TOWN_DAILY_IMAGE_LIMIT=12
AI_TOWN_DAILY_VOICE_LIMIT=30
